{
  "name": "service-booking-marketplace",
  "version": "0.0.1",
  "description": "Booking system for a single service provider: services, availability, deposits by EFT, proof of payment and an admin portal.",
  "author": "Glory Mabunda",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write .",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:demo": "node dist/scripts/reset-demo.js && node dist/scripts/migrate.js && node dist/scripts/seed-demo.js && node dist/main.js",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down --volumes && docker compose up -d --wait",
    "db:psql": "docker compose exec db psql -U booking -d booking",
    "db:migrate": "kysely migrate:latest",
    "db:migrate:test": "kysely migrate:latest --environment test",
    "db:migrate:make": "kysely migrate:make",
    "db:migrate:down": "kysely migrate:down",
    "db:migrate:list": "kysely migrate:list",
    "db:types": "kysely-codegen --dialect postgres --out-file src/database/database.types.ts && prettier --write src/database/database.types.ts",
    "seed:admin": "nest build && node dist/scripts/seed-admin.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:integration": "vitest run --config ./vitest.config.integration.ts",
    "test:all": "npm test && npm run test:integration",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/serve-static": "^12.0.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "kysely": "^0.29.6",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "kysely-codegen": "^0.20.0",
    "kysely-ctl": "^0.21.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.2"
  }
}
