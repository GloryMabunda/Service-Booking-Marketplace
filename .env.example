# Environment variables for the Service Booking System (#20).
#
# Copy this file to .env and adjust the values. .env is git-ignored: never
# commit real secrets. Real environment variables (for example in CI or on the
# server) take priority over .env. The rules for each variable are in
# src/config/env.ts; the app refuses to start if one is missing or invalid.

# development | test | production (default: development)
NODE_ENV=development

# Port the API listens on (default: 3000)
PORT=3000

# PostgreSQL for the app and migrations (required). This is the local Docker
# database from docker-compose.yml; production uses a managed database.
DATABASE_URL=postgres://booking:booking@localhost:5432/booking

# Separate database for automated tests; tests wipe it freely.
TEST_DATABASE_URL=postgres://booking:booking@localhost:5432/booking_test
