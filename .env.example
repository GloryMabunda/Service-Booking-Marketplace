# Environment variables for the Service Booking System (#20).
#
# Copy this file to .env and adjust the values. .env is git-ignored: never
# commit real secrets. Real environment variables (for example in CI or on the
# server) take priority over .env. The rules for each variable are in
# src/config/env.ts; the app refuses to start if one is missing or invalid.

# development | test | production (default: development)
NODE_ENV=development

# Port the API listens on (default: 3000)
PORT=3000

# PostgreSQL for the app and migrations (required). This is the local Docker
# database from docker-compose.yml; production uses a managed database.
DATABASE_URL=postgres://booking:booking@localhost:5432/booking

# Separate database for automated tests; tests wipe it freely.
TEST_DATABASE_URL=postgres://booking:booking@localhost:5432/booking_test

# The administrator account, created or updated by `npm run seed:admin` (#26).
# Only the seed script reads these; the app itself doesn't. The password must
# be at least 12 characters and is stored only as an Argon2id hash. Choose
# your own: never use this example password, and never commit a real one.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-to-a-long-password

# How many proxies (load balancers) are in front of the app on the server, so
# the visitor's real address is used. Empty locally; usually 1 when hosted.
TRUST_PROXY=

# Where uploaded files (proofs of payment, website photos) are kept on this
# computer. Default: ./uploads, which is git-ignored.
UPLOAD_DIR=

# Email (M5, #55). Leave SMTP_HOST empty to send no email: bookings still work,
# and the confirmation page says the email couldn't be sent. For Gmail use
# smtp.gmail.com, port 587 and an app password, never your real password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Who emails come from, for example: Make Up by Glory <bookings@example.com>
MAIL_FROM=
# Travel fees (#115): a free OpenRouteService key (https://openrouteservice.org)
# finds the road distance to a client's address. Leave empty to turn travel
# bookings off.
OPENROUTESERVICE_API_KEY=

# The public address of the site, used for links in emails (default: http://localhost:PORT)
PUBLIC_URL=
